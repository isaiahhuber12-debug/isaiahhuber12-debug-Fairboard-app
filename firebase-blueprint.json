{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Global platform administrator registry entry.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the global admin." },
        "email": { "type": "string", "description": "Verified email address." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile containing PII isolated to the owner.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID." },
        "displayName": { "type": "string", "description": "Public display name." },
        "email": { "type": "string", "description": "Private user email." },
        "photoUrl": { "type": "string", "description": "Optional avatar URL." },
        "activeGroupId": { "type": "string", "description": "Optional last active group ID." },
        "smsPhone": { "type": "string", "description": "Optional E.164 mobile phone number for SMS push alerts (PII isolated to owner)." },
        "smsEnabled": { "type": "boolean", "description": "Master opt-in for SMS push notifications." },
        "smsForMessages": { "type": "boolean", "description": "Receive SMS push notifications for new group chat messages." },
        "smsForEvents": { "type": "boolean", "description": "Receive SMS push notifications for calendar events and reminders." },
        "personalColorTheme": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^(default|emerald|violet|coral|ocean|rose|amber|indigo|custom:#[0-9A-Fa-f]{6}|dual:#[0-9A-Fa-f]{6}:#[0-9A-Fa-f]{6})$",
          "description": "Optional per-user accent color theme preset or custom hex pair isolated strictly to this user."
        },
        "personalColorMode": {
          "type": "string",
          "enum": ["system", "light", "dark"],
          "maxLength": 10,
          "description": "Optional per-user display mode preference (system, light, or dark) isolated strictly to this user."
        },
        "personalBackground": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^(theme|default|ocean-mist|emerald-grove|sunset-warmth|lavender-studio|midnight-canvas|dot-grid|diagonal-weave|emerald|sunset|midnight|royal|teal-ocean|solid:#[0-9A-Fa-f]{6}|gradient:#[0-9A-Fa-f]{6}:#[0-9A-Fa-f]{6})$",
          "description": "Optional per-user main app canvas background isolated strictly to this user."
        },
        "personalBannerBackground": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^(theme|default|ocean-mist|emerald-grove|sunset-warmth|lavender-studio|midnight-canvas|dot-grid|diagonal-weave|emerald|sunset|midnight|royal|teal-ocean|solid:#[0-9A-Fa-f]{6}|gradient:#[0-9A-Fa-f]{6}:#[0-9A-Fa-f]{6})$",
          "description": "Optional per-user header and group banner background isolated strictly to this user."
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "JoinedGroupRef": {
      "title": "JoinedGroupRef",
      "description": "User's personal index of joined RallyHub groups.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "groupName": { "type": "string" },
        "groupCode": { "type": "string" },
        "role": { "type": "string", "enum": ["CREATOR", "ADMIN", "ORGANIZER", "PARTICIPANT"] },
        "groupBackground": { "type": "string", "description": "Optional group banner background preset or hex spec." },
        "groupImageUrl": { "type": "string", "description": "Optional group profile image URL (HTTPS or compressed base64 image data URI)." },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "groupName", "groupCode", "role", "joinedAt", "updatedAt"]
    },
    "GroupCodeEntry": {
      "title": "GroupCodeEntry",
      "description": "Invite code lookup entry mapping uppercase Group Code to groupId.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "groupName": { "type": "string" },
        "createdBy": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "groupName", "createdBy", "active", "createdAt", "updatedAt"]
    },
    "RallyGroup": {
      "title": "RallyGroup",
      "description": "Top-level event community organization.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "groupCode": { "type": "string" },
        "ownerId": { "type": "string", "description": "UID of the group creator with full control." },
        "groupBackground": { "type": "string", "description": "Optional custom background preset or hex spec for group banner and cards." },
        "groupImageUrl": { "type": "string", "description": "Optional group profile image URL (HTTPS or compressed base64 image data URI) set by the group creator." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "groupCode", "ownerId", "createdAt", "updatedAt"]
    },
    "GroupMember": {
      "title": "GroupMember",
      "description": "Group participant/organizer/admin/creator membership without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["CREATOR", "ADMIN", "ORGANIZER", "PARTICIPANT"] },
        "tasksSignedUpCount": { "type": "integer" },
        "messagesSentCount": { "type": "integer" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "tasksSignedUpCount", "messagesSentCount", "joinedAt", "updatedAt"]
    },
    "MemberContact": {
      "title": "MemberContact",
      "description": "Private member contact record containing cell phone number and optional email, readable strictly by the Group Creator, Group Admins, Global Admins, or the signed-in owner.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID or guest_* session UID." },
        "displayName": { "type": "string", "description": "Member full or display name." },
        "phoneNumber": { "type": "string", "description": "E.164 cell phone number (e.g. +15551234567)." },
        "email": { "type": "string", "description": "Optional Google email address when signed in via Google." },
        "authMethod": { "type": "string", "enum": ["GOOGLE", "CODE_GUEST"], "description": "Whether member joined via Google Sign-In or Group Code + Name." },
        "smsEnabled": { "type": "boolean", "description": "Whether member opted in to SMS text alerts." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": ["uid", "displayName", "phoneNumber", "authMethod", "smsEnabled", "updatedAt"]
    },
    "RallyEvent": {
      "title": "RallyEvent",
      "description": "Calendar event within a group.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "startEpochMs": { "type": "integer" },
        "endEpochMs": { "type": "integer" },
        "createdBy": { "type": "string" },
        "organizerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "location", "category", "startEpochMs", "endEpochMs", "createdBy", "organizerName", "createdAt", "updatedAt"]
    },
    "EventTask": {
      "title": "EventTask",
      "description": "Volunteer/participant task shift attached to a calendar event.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "deadlineEpochMs": { "type": "integer" },
        "capacity": { "type": "integer" },
        "assignedCount": { "type": "integer" },
        "assignedUids": { "type": "array" },
        "assignedNames": { "type": "array" },
        "status": { "type": "string", "enum": ["OPEN", "FILLED", "COMPLETED"] },
        "chatChannelId": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "title", "description", "deadlineEpochMs", "capacity", "assignedCount", "assignedUids", "assignedNames", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "ChatChannel": {
      "title": "ChatChannel",
      "description": "Role-gated group chat channel.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "accessLevel": { "type": "string", "enum": ["ALL", "ORGANIZER", "ADMIN"] },
        "eventId": { "type": "string" },
        "createdBy": { "type": "string" },
        "messageCount": { "type": "integer" },
        "lastMessagePreview": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "accessLevel", "createdBy", "messageCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time text message inside a channel.",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["CREATOR", "ADMIN", "ORGANIZER", "PARTICIPANT"] },
        "text": { "type": "string" },
        "messageType": { "type": "string", "enum": ["TEXT", "ANNOUNCEMENT", "TASK_UPDATE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "senderId", "senderName", "senderRole", "text", "messageType", "createdAt"]
    },
    "HubNotification": {
      "title": "HubNotification",
      "description": "Targeted notification for announcements, task updates, and deadline reminders.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "notificationType": { "type": "string", "enum": ["ANNOUNCEMENT", "TASK_UPDATE", "DEADLINE_REMINDER"] },
        "targetScope": { "type": "string", "enum": ["ALL", "ROLE", "CHANNEL"] },
        "targetRole": { "type": "string", "enum": ["ALL", "PARTICIPANT", "ORGANIZER", "ADMIN"] },
        "targetChannelId": { "type": "string" },
        "targetChannelName": { "type": "string" },
        "targetEventId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "scheduledForEpochMs": { "type": "integer" },
        "approvalStatus": { "type": "string", "enum": ["PENDING", "APPROVED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "notificationType", "targetScope", "targetRole", "senderId", "senderName", "createdAt"]
    },
    "ActivityLogEntry": {
      "title": "ActivityLogEntry",
      "description": "Audit trail entry capturing user actions within a group for manager visibility.",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "description": "Firebase Auth UID of the acting member." },
        "actorName": { "type": "string", "description": "Display name of the acting member." },
        "actorRole": { "type": "string", "enum": ["CREATOR", "ADMIN", "ORGANIZER", "PARTICIPANT"] },
        "category": { "type": "string", "enum": ["TASK", "CALENDAR", "MEMBER", "CHANNEL", "ALERT", "GROUP"] },
        "action": {
          "type": "string",
          "enum": [
            "TASK_CREATED",
            "TASK_UPDATED",
            "TASK_COMPLETED",
            "TASK_DELETED",
            "TASK_CLAIMED",
            "TASK_RELEASED",
            "EVENT_CREATED",
            "EVENT_UPDATED",
            "EVENT_DELETED",
            "MEMBER_JOINED",
            "MEMBER_ROLE_CHANGED",
            "MEMBER_DELETED",
            "CHANNEL_CREATED",
            "CHANNEL_UPDATED",
            "CHANNEL_DELETED",
            "ALERT_SENT",
            "ALERT_APPROVED",
            "ALERT_DELETED",
            "GROUP_CREATED",
            "GROUP_UPDATED"
          ]
        },
        "summary": { "type": "string", "description": "Human-readable description of the action taken." },
        "details": { "type": "string", "description": "Optional secondary context such as event or volunteer info." },
        "targetId": { "type": "string", "description": "Optional ID of the affected document." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "actorName", "actorRole", "category", "action", "summary", "createdAt"]
    },
    "AppAppearance": {
      "title": "AppAppearance",
      "description": "Shared main application interface background setting customized by an Admin.",
      "type": "object",
      "properties": {
        "appBackground": { "type": "string" },
        "sourceGroupId": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedByName": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appBackground", "sourceGroupId", "updatedBy", "updatedByName", "updatedAt"]
    },
    "GroupPoll": {
      "title": "GroupPoll",
      "description": "Anonymous group poll storing question, choices, and aggregate counts without exposing voter identities.",
      "type": "object",
      "properties": {
        "question": { "type": "string", "minLength": 2, "maxLength": 240, "description": "Poll question prompt." },
        "description": { "type": "string", "maxLength": 500, "description": "Optional context for voters." },
        "options": { "type": "array", "description": "List of 2 to 10 poll option labels." },
        "optionCounts": { "type": "array", "description": "Aggregate vote counts matching each option index." },
        "totalVotes": { "type": "integer", "description": "Total anonymous ballots cast." },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"], "description": "Whether the poll is currently accepting votes." },
        "createdBy": { "type": "string", "maxLength": 128, "description": "UID of the creator, admin, or organizer who created the poll." },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Display name of the poll author." },
        "createdByRole": { "type": "string", "enum": ["CREATOR", "ADMIN", "ORGANIZER"], "description": "Role of the poll author when created." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["question", "options", "optionCounts", "totalVotes", "status", "createdBy", "createdByName", "createdByRole", "createdAt", "updatedAt"]
    },
    "PollBallot": {
      "title": "PollBallot",
      "description": "Individual member ballot storing userId, displayName, and optionIndex; strictly readable only by the voter (own doc) or the Group Creator.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "description": "Voter UID matching document ID." },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Voter display name for Creator View." },
        "optionIndex": { "type": "integer", "description": "Zero-based index of the chosen poll option." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "optionIndex", "createdAt"]
    }
  },
  "firestore": {
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppAppearance" },
      "description": "Global application appearance configuration writable by verified group or global admins."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Global platform admins."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile isolated to owner."
    },
    "/users/{uid}/joinedGroups/{groupId}": {
      "schema": { "$ref": "#/entities/JoinedGroupRef" },
      "description": "User's joined group references."
    },
    "/groupCodes/{code}": {
      "schema": { "$ref": "#/entities/GroupCodeEntry" },
      "description": "Invite code to groupId lookup."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/RallyGroup" },
      "description": "RallyHub group metadata."
    },
    "/groups/{groupId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/GroupMember" },
      "description": "Group member roles and engagement counters."
    },
    "/groups/{groupId}/memberContacts/{memberId}": {
      "schema": { "$ref": "#/entities/MemberContact" },
      "description": "Private member contact information (cell phone & name) visible only to Group Creator, Admins, and the member."
    },
    "/groups/{groupId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/RallyEvent" },
      "description": "Calendar events for a group."
    },
    "/groups/{groupId}/events/{eventId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/EventTask" },
      "description": "Volunteer tasks for an event."
    },
    "/groups/{groupId}/channels/{channelId}": {
      "schema": { "$ref": "#/entities/ChatChannel" },
      "description": "Role-scoped group chat channels."
    },
    "/groups/{groupId}/channels/{channelId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a chat channel."
    },
    "/groups/{groupId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/HubNotification" },
      "description": "Targeted push alerts and announcements."
    },
    "/groups/{groupId}/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLogEntry" },
      "description": "Immutable group activity log entries visible to group managers."
    },
    "/groups/{groupId}/polls/{pollId}": {
      "schema": { "$ref": "#/entities/GroupPoll" },
      "description": "Group polls with anonymous aggregate counts."
    },
    "/groups/{groupId}/polls/{pollId}/ballots/{userId}": {
      "schema": { "$ref": "#/entities/PollBallot" },
      "description": "Individual voter ballots readable only by the voter (own doc) or the Group Creator."
    }
  }
}
