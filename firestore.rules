rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isGuestId(id) {
      return id is string && id.size() >= 22 && id.size() <= 46 && id.matches('^guest_[a-zA-Z0-9]+$');
    }

    function isValidCodeId(code) {
      return code is string && code.size() >= 4 && code.size() <= 24 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidPhone(phone) {
      return phone is string && phone.size() >= 8 && phone.size() <= 20 && phone.matches('^\\+[1-9][0-9]{7,14}$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true &&
             ('email' in request.auth.token) &&
             (request.auth.token.email == 'isaiahhuber12@gmail.com' ||
              request.auth.token.email == 'isaiahhuber2002@gmail.com');
    }

    function isGlobalAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Group Membership & RBAC Helpers ---
    function groupDocExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function isGroupMember(groupId) {
      return isSignedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    function memberRole(groupId) {
      return get(memberPath(groupId, request.auth.uid)).data.role;
    }

    function isGroupCreator(groupId) {
      return isSignedIn() &&
             groupDocExists(groupId) &&
             get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isGroupCreatorAfter(groupId) {
      return isSignedIn() &&
             existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
             getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isGroupAdminOnly(groupId) {
      return isGroupMember(groupId) && memberRole(groupId) == 'ADMIN';
    }

    function isGroupAdminOrCreator(groupId) {
      return isGroupCreator(groupId) ||
             (isGroupMember(groupId) && memberRole(groupId) in ['CREATOR', 'ADMIN']);
    }

    function isGroupOrganizerOrHigher(groupId) {
      return isGroupCreator(groupId) ||
             (isGroupMember(groupId) && memberRole(groupId) in ['CREATOR', 'ADMIN', 'ORGANIZER']);
    }

    function canAccessChannel(groupId, accessLevel) {
      return accessLevel == 'ALL' ||
             (accessLevel == 'ORGANIZER' && isGroupOrganizerOrHigher(groupId)) ||
             (accessLevel == 'ADMIN' && isGroupAdminOrCreator(groupId));
    }

    function canAccessChannelById(groupId, channelId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/channels/$(channelId)) &&
             canAccessChannel(
               groupId,
               get(/databases/$(database)/documents/groups/$(groupId)/channels/$(channelId)).data.accessLevel
             );
    }

    function isPublicGroupChannel(groupId, channelId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/channels/$(channelId)) &&
             get(/databases/$(database)/documents/groups/$(groupId)/channels/$(channelId)).data.accessLevel == 'ALL';
    }

    function canAccessNotification(groupId, targetRole) {
      return targetRole == 'ALL' ||
             targetRole == 'PARTICIPANT' ||
             (targetRole == 'ORGANIZER' && isGroupOrganizerOrHigher(groupId)) ||
             (targetRole == 'ADMIN' && isGroupAdminOrCreator(groupId));
    }

    // --- Schema Validators ---
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
             isValidId(data.uid) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidColorTheme(val) {
      return val is string &&
             val.size() >= 1 &&
             val.size() <= 24 &&
             val.matches('^(default|emerald|violet|coral|ocean|rose|amber|indigo|custom:#[0-9A-Fa-f]{6}|dual:#[0-9A-Fa-f]{6}:#[0-9A-Fa-f]{6})$');
    }

    function isValidColorMode(val) {
      return val is string &&
             val.size() >= 4 &&
             val.size() <= 10 &&
             val in ['system', 'light', 'dark'];
    }

    function isValidBackgroundSpec(bg) {
      return bg is string &&
             bg.size() >= 1 &&
             bg.size() <= 40 &&
             bg.matches('^(theme|default|ocean-mist|emerald-grove|sunset-warmth|lavender-studio|midnight-canvas|dot-grid|diagonal-weave|emerald|sunset|midnight|royal|teal-ocean|solid:#[0-9A-Fa-f]{6}|gradient:#[0-9A-Fa-f]{6}:#[0-9A-Fa-f]{6})$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'activeGroupId', 'smsPhone', 'smsEnabled', 'smsForMessages', 'smsForEvents', 'personalColorTheme', 'personalColorMode', 'personalBackground', 'personalBannerBackground', 'createdAt', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('activeGroupId' in data) || data.activeGroupId == null || isValidId(data.activeGroupId)) &&
             (!('smsPhone' in data) || data.smsPhone == null || isValidPhone(data.smsPhone)) &&
             (!('smsEnabled' in data) || data.smsEnabled is bool) &&
             (!('smsForMessages' in data) || data.smsForMessages is bool) &&
             (!('smsForEvents' in data) || data.smsForEvents is bool) &&
             (!('personalColorTheme' in data) || data.personalColorTheme == null || isValidColorTheme(data.personalColorTheme)) &&
             (!('personalColorMode' in data) || data.personalColorMode == null || isValidColorMode(data.personalColorMode)) &&
             (!('personalBackground' in data) || data.personalBackground == null || isValidBackgroundSpec(data.personalBackground)) &&
             (!('personalBannerBackground' in data) || data.personalBannerBackground == null || isValidBackgroundSpec(data.personalBannerBackground)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMemberContact(data) {
      return data.keys().hasAll(['uid', 'displayName', 'phoneNumber', 'authMethod', 'smsEnabled', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'phoneNumber', 'email', 'authMethod', 'smsEnabled', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             isValidPhone(data.phoneNumber) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() >= 3 && data.email.size() <= 160)) &&
             data.authMethod in ['GOOGLE', 'CODE_GUEST'] &&
             data.smsEnabled is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGroupImageUrl(url) {
      return url is string &&
             url.size() >= 10 &&
             url.size() <= 200000 &&
             (
               (url.size() <= 1000 && url.matches('^https://[^\\s]+$')) ||
               url.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=]+$')
             );
    }

    function isValidJoinedGroupRef(data) {
      return data.keys().hasAll(['groupId', 'groupName', 'groupCode', 'role', 'joinedAt', 'updatedAt']) &&
             data.keys().hasOnly(['groupId', 'groupName', 'groupCode', 'role', 'groupBackground', 'groupImageUrl', 'joinedAt', 'updatedAt']) &&
             isValidId(data.groupId) &&
             data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 80 &&
             isValidCodeId(data.groupCode) &&
             data.role in ['CREATOR', 'ADMIN', 'ORGANIZER', 'PARTICIPANT'] &&
             (!('groupBackground' in data) || data.groupBackground == null || isValidBackgroundSpec(data.groupBackground)) &&
             (!('groupImageUrl' in data) || data.groupImageUrl == null || isValidGroupImageUrl(data.groupImageUrl)) &&
             isValidTimestamp(data.joinedAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGroupCode(data) {
      return data.keys().hasAll(['groupId', 'groupName', 'createdBy', 'active', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['groupId', 'groupName', 'createdBy', 'active', 'createdAt', 'updatedAt']) &&
             isValidId(data.groupId) &&
             data.groupName is string && data.groupName.size() >= 2 && data.groupName.size() <= 80 &&
             isValidId(data.createdBy) &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['name', 'description', 'groupCode', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'description', 'groupCode', 'ownerId', 'groupBackground', 'groupImageUrl', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
             data.description is string && data.description.size() <= 500 &&
             isValidCodeId(data.groupCode) &&
             isValidId(data.ownerId) &&
             (!('groupBackground' in data) || data.groupBackground == null || isValidBackgroundSpec(data.groupBackground)) &&
             (!('groupImageUrl' in data) || data.groupImageUrl == null || isValidGroupImageUrl(data.groupImageUrl)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMember(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'tasksSignedUpCount', 'messagesSentCount', 'joinedAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'role', 'tasksSignedUpCount', 'messagesSentCount', 'joinedAt', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.role in ['CREATOR', 'ADMIN', 'ORGANIZER', 'PARTICIPANT'] &&
             data.tasksSignedUpCount is int && data.tasksSignedUpCount >= 0 && data.tasksSignedUpCount <= 10000 &&
             data.messagesSentCount is int && data.messagesSentCount >= 0 && data.messagesSentCount <= 100000 &&
             isValidTimestamp(data.joinedAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'description', 'location', 'category', 'startEpochMs', 'endEpochMs', 'createdBy', 'organizerName', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['title', 'description', 'location', 'category', 'startEpochMs', 'endEpochMs', 'createdBy', 'organizerName', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.location is string && data.location.size() >= 1 && data.location.size() <= 160 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.startEpochMs is int && data.startEpochMs > 0 &&
             data.endEpochMs is int && data.endEpochMs >= data.startEpochMs &&
             isValidId(data.createdBy) &&
             data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 60 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['eventId', 'title', 'description', 'deadlineEpochMs', 'capacity', 'assignedCount', 'assignedUids', 'assignedNames', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['eventId', 'title', 'description', 'deadlineEpochMs', 'capacity', 'assignedCount', 'assignedUids', 'assignedNames', 'status', 'chatChannelId', 'createdBy', 'createdAt', 'updatedAt']) &&
             isValidId(data.eventId) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 600 &&
             data.deadlineEpochMs is int && data.deadlineEpochMs > 0 &&
             data.capacity is int && data.capacity >= 1 && data.capacity <= 500 &&
             data.assignedCount is int && data.assignedCount >= 0 && data.assignedCount <= data.capacity &&
             data.assignedUids is list && data.assignedUids.size() <= 500 &&
             (data.assignedUids.size() == 0 || data.assignedUids[0] is string) &&
             data.assignedNames is list && data.assignedNames.size() <= 500 &&
             (data.assignedNames.size() == 0 || data.assignedNames[0] is string) &&
             data.assignedUids.size() == data.assignedCount &&
             data.status in ['OPEN', 'FILLED', 'COMPLETED'] &&
             (!('chatChannelId' in data) || data.chatChannelId == null || isValidId(data.chatChannelId)) &&
             isValidId(data.createdBy) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChannel(data) {
      return data.keys().hasAll(['name', 'description', 'accessLevel', 'createdBy', 'messageCount', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'description', 'accessLevel', 'eventId', 'createdBy', 'messageCount', 'lastMessagePreview', 'lastMessageAt', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
             data.description is string && data.description.size() <= 300 &&
             data.accessLevel in ['ALL', 'ORGANIZER', 'ADMIN'] &&
             (!('eventId' in data) || data.eventId == null || isValidId(data.eventId)) &&
             isValidId(data.createdBy) &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 1000000 &&
             (!('lastMessagePreview' in data) || data.lastMessagePreview == null || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 200)) &&
             (!('lastMessageAt' in data) || data.lastMessageAt == null || isValidTimestamp(data.lastMessageAt)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['channelId', 'senderId', 'senderName', 'senderRole', 'text', 'messageType', 'createdAt']) &&
             data.keys().hasOnly(['channelId', 'senderId', 'senderName', 'senderRole', 'text', 'messageType', 'createdAt', 'updatedAt']) &&
             isValidId(data.channelId) &&
             isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.senderRole in ['CREATOR', 'ADMIN', 'ORGANIZER', 'PARTICIPANT'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.messageType in ['TEXT', 'ANNOUNCEMENT', 'TASK_UPDATE'] &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || data.updatedAt == null || isValidTimestamp(data.updatedAt));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['title', 'body', 'notificationType', 'targetScope', 'targetRole', 'senderId', 'senderName', 'createdAt']) &&
             data.keys().hasOnly(['title', 'body', 'notificationType', 'targetScope', 'targetRole', 'targetChannelId', 'targetChannelName', 'targetEventId', 'senderId', 'senderName', 'scheduledForEpochMs', 'approvalStatus', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
             data.body is string && data.body.size() >= 2 && data.body.size() <= 600 &&
             data.notificationType in ['ANNOUNCEMENT', 'TASK_UPDATE', 'DEADLINE_REMINDER'] &&
             data.targetScope in ['ALL', 'ROLE', 'CHANNEL'] &&
             data.targetRole in ['ALL', 'PARTICIPANT', 'ORGANIZER', 'ADMIN'] &&
             (!('targetChannelId' in data) || data.targetChannelId == null || isValidId(data.targetChannelId)) &&
             (!('targetChannelName' in data) || data.targetChannelName == null || (data.targetChannelName is string && data.targetChannelName.size() <= 80)) &&
             (!('targetEventId' in data) || data.targetEventId == null || isValidId(data.targetEventId)) &&
             isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             (!('scheduledForEpochMs' in data) || data.scheduledForEpochMs == null || (data.scheduledForEpochMs is int && data.scheduledForEpochMs > 0)) &&
             (!('approvalStatus' in data) || data.approvalStatus in ['PENDING', 'APPROVED']) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || data.updatedAt == null || isValidTimestamp(data.updatedAt));
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['actorId', 'actorName', 'actorRole', 'category', 'action', 'summary', 'createdAt']) &&
             data.keys().hasOnly(['actorId', 'actorName', 'actorRole', 'category', 'action', 'summary', 'details', 'targetId', 'createdAt']) &&
             isValidId(data.actorId) &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 60 &&
             data.actorRole in ['CREATOR', 'ADMIN', 'ORGANIZER', 'PARTICIPANT'] &&
             data.category in ['TASK', 'CALENDAR', 'MEMBER', 'CHANNEL', 'ALERT', 'GROUP'] &&
             data.action in [
               'TASK_CREATED', 'TASK_UPDATED', 'TASK_COMPLETED', 'TASK_DELETED', 'TASK_CLAIMED', 'TASK_RELEASED',
               'EVENT_CREATED', 'EVENT_UPDATED', 'EVENT_DELETED',
               'MEMBER_JOINED', 'MEMBER_ROLE_CHANGED', 'MEMBER_DELETED',
               'CHANNEL_CREATED', 'CHANNEL_UPDATED', 'CHANNEL_DELETED',
               'ALERT_SENT', 'ALERT_APPROVED', 'ALERT_DELETED',
               'GROUP_CREATED', 'GROUP_UPDATED'
             ] &&
             data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 200 &&
             (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 300)) &&
             (!('targetId' in data) || data.targetId == null || isValidId(data.targetId)) &&
             isValidTimestamp(data.createdAt) &&
             data.createdAt == request.time;
    }

    // --- Poll & Ballot Schema Validators ---

    function pollPath(groupId, pollId) {
      return /databases/$(database)/documents/groups/$(groupId)/polls/$(pollId);
    }

    function ballotPath(groupId, pollId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/polls/$(pollId)/ballots/$(uid);
    }

    function isValidPollOptionAt(options, idx) {
      return options.size() <= idx ||
             (options[idx] is string && options[idx].size() >= 1 && options[idx].size() <= 120);
    }

    function isValidPollCountAt(counts, idx) {
      return counts.size() <= idx ||
             (counts[idx] is int && counts[idx] >= 0 && counts[idx] <= 100000);
    }

    function isValidZeroPollCounts(counts) {
      return counts.size() >= 2 &&
             counts[0] == 0 &&
             counts[1] == 0 &&
             (counts.size() <= 2 || counts[2] == 0) &&
             (counts.size() <= 3 || counts[3] == 0) &&
             (counts.size() <= 4 || counts[4] == 0) &&
             (counts.size() <= 5 || counts[5] == 0) &&
             (counts.size() <= 6 || counts[6] == 0) &&
             (counts.size() <= 7 || counts[7] == 0) &&
             (counts.size() <= 8 || counts[8] == 0) &&
             (counts.size() <= 9 || counts[9] == 0);
    }

    function isValidOptionCountVote(existingCounts, incomingCounts, votedIdx) {
      return incomingCounts.size() == existingCounts.size() &&
             votedIdx is int &&
             votedIdx >= 0 &&
             votedIdx < existingCounts.size() &&
             incomingCounts[votedIdx] == existingCounts[votedIdx] + 1 &&
             (existingCounts.size() <= 0 || votedIdx == 0 || incomingCounts[0] == existingCounts[0]) &&
             (existingCounts.size() <= 1 || votedIdx == 1 || incomingCounts[1] == existingCounts[1]) &&
             (existingCounts.size() <= 2 || votedIdx == 2 || incomingCounts[2] == existingCounts[2]) &&
             (existingCounts.size() <= 3 || votedIdx == 3 || incomingCounts[3] == existingCounts[3]) &&
             (existingCounts.size() <= 4 || votedIdx == 4 || incomingCounts[4] == existingCounts[4]) &&
             (existingCounts.size() <= 5 || votedIdx == 5 || incomingCounts[5] == existingCounts[5]) &&
             (existingCounts.size() <= 6 || votedIdx == 6 || incomingCounts[6] == existingCounts[6]) &&
             (existingCounts.size() <= 7 || votedIdx == 7 || incomingCounts[7] == existingCounts[7]) &&
             (existingCounts.size() <= 8 || votedIdx == 8 || incomingCounts[8] == existingCounts[8]) &&
             (existingCounts.size() <= 9 || votedIdx == 9 || incomingCounts[9] == existingCounts[9]);
    }

    function isValidPoll(data) {
      return data.keys().hasAll(['question', 'options', 'optionCounts', 'totalVotes', 'status', 'createdBy', 'createdByName', 'createdByRole', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['question', 'description', 'options', 'optionCounts', 'totalVotes', 'status', 'createdBy', 'createdByName', 'createdByRole', 'createdAt', 'updatedAt']) &&
             data.question is string && data.question.size() >= 2 && data.question.size() <= 240 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             data.options is list && data.options.size() >= 2 && data.options.size() <= 10 &&
             data.options[0] is string && data.options[0].size() >= 1 && data.options[0].size() <= 120 &&
             data.options[1] is string && data.options[1].size() >= 1 && data.options[1].size() <= 120 &&
             isValidPollOptionAt(data.options, 2) &&
             isValidPollOptionAt(data.options, 3) &&
             isValidPollOptionAt(data.options, 4) &&
             isValidPollOptionAt(data.options, 5) &&
             isValidPollOptionAt(data.options, 6) &&
             isValidPollOptionAt(data.options, 7) &&
             isValidPollOptionAt(data.options, 8) &&
             isValidPollOptionAt(data.options, 9) &&
             data.optionCounts is list && data.optionCounts.size() == data.options.size() &&
             data.optionCounts[0] is int && data.optionCounts[0] >= 0 && data.optionCounts[0] <= 100000 &&
             data.optionCounts[1] is int && data.optionCounts[1] >= 0 && data.optionCounts[1] <= 100000 &&
             isValidPollCountAt(data.optionCounts, 2) &&
             isValidPollCountAt(data.optionCounts, 3) &&
             isValidPollCountAt(data.optionCounts, 4) &&
             isValidPollCountAt(data.optionCounts, 5) &&
             isValidPollCountAt(data.optionCounts, 6) &&
             isValidPollCountAt(data.optionCounts, 7) &&
             isValidPollCountAt(data.optionCounts, 8) &&
             isValidPollCountAt(data.optionCounts, 9) &&
             data.totalVotes is int && data.totalVotes >= 0 && data.totalVotes <= 100000 &&
             data.status in ['OPEN', 'CLOSED'] &&
             isValidId(data.createdBy) &&
             data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 60 &&
             data.createdByRole in ['CREATOR', 'ADMIN', 'ORGANIZER'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPollBallot(data) {
      return data.keys().hasAll(['userId', 'displayName', 'optionIndex', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'displayName', 'optionIndex', 'createdAt']) &&
             isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.optionIndex is int && data.optionIndex >= 0 && data.optionIndex < 10 &&
             isValidTimestamp(data.createdAt);
    }

    // --- Collection Rules ---

    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isGlobalAdmin());
      allow list: if isGlobalAdmin();
      allow create: if isSignedIn() && isValidId(uid) && isValidAdminRecord(incoming()) && isGlobalAdmin();
      allow update, delete: if isGlobalAdmin() && uid != request.auth.uid;
    }

    match /appSettings/{settingId} {
      allow get: if settingId == 'appearance';
      allow list: if false;
      allow create, update: if false;
      allow delete: if isGlobalAdmin();
    }

    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(uid) && request.auth.uid == uid &&
                       incoming().uid == request.auth.uid &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(uid) && request.auth.uid == uid &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'activeGroupId', 'smsPhone', 'smsEnabled', 'smsForMessages', 'smsForEvents', 'personalColorTheme', 'personalColorMode', 'personalBackground', 'personalBannerBackground', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;

      match /joinedGroups/{groupId} {
        allow get: if isSignedIn() && isValidId(groupId) && request.auth.uid == uid;
        allow list: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && isValidId(groupId) && request.auth.uid == uid &&
                         incoming().groupId == groupId &&
                         isValidJoinedGroupRef(incoming());
        allow update: if isSignedIn() && isValidId(groupId) && request.auth.uid == uid &&
                         isValidJoinedGroupRef(incoming()) &&
                         incoming().groupId == existing().groupId &&
                         incoming().joinedAt == existing().joinedAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['groupName', 'groupCode', 'role', 'groupBackground', 'groupImageUrl', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(groupId) && request.auth.uid == uid;
      }
    }

    match /groupCodes/{code} {
      allow get: if isValidCodeId(code);
      allow list: if false;
      allow create: if isSignedIn() && isValidCodeId(code) &&
                       isValidGroupCode(incoming()) &&
                       incoming().createdBy == request.auth.uid && (
                         isGroupCreator(incoming().groupId) ||
                         isGroupAdminOrCreator(incoming().groupId) ||
                         isGlobalAdmin() ||
                         (existsAfter(/databases/$(database)/documents/groups/$(incoming().groupId)) &&
                          getAfter(/databases/$(database)/documents/groups/$(incoming().groupId)).data.ownerId == request.auth.uid)
                       );
      allow update: if isSignedIn() && isValidCodeId(code) &&
                       isValidGroupCode(incoming()) &&
                       (isGroupAdminOrCreator(existing().groupId) || isGlobalAdmin()) &&
                       incoming().groupId == existing().groupId &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['groupName', 'active', 'updatedAt']);
      allow delete: if isSignedIn() && isValidCodeId(code) &&
                       (isGroupAdminOrCreator(existing().groupId) || isGlobalAdmin());
    }

    match /groups/{groupId} {
      allow get: if isValidId(groupId) && (
                    resource == null ||
                    (isSignedIn()
                      ? (isGroupMember(groupId) || existing().ownerId == request.auth.uid || isGlobalAdmin())
                      : existing().groupCode is string)
                  );
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isGlobalAdmin());
      allow create: if isSignedIn() && isValidId(groupId) &&
                       isValidGroup(incoming()) &&
                       incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(groupId) &&
                       isValidGroup(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt && (
                         ((isGroupCreator(groupId) || isGlobalAdmin()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'groupCode', 'groupImageUrl', 'updatedAt'])) ||
                         (isGroupAdminOrCreator(groupId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'groupCode', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(groupId) &&
                       (isGroupCreator(groupId) || isGlobalAdmin());

      match /members/{memberId} {
        allow get: if isValidId(memberId) && (
                      isSignedIn()
                        ? (request.auth.uid == memberId || isGroupMember(groupId) || isGlobalAdmin())
                        : groupDocExists(groupId)
                    );
        allow list: if isSignedIn()
                       ? (isGroupMember(groupId) || isGlobalAdmin())
                       : groupDocExists(groupId);
        allow create: if isValidId(memberId) &&
                         isValidMember(incoming()) &&
                         incoming().uid == memberId && (
                           (isSignedIn() && (
                             (request.auth.uid == memberId && incoming().role == 'CREATOR' &&
                              (isGroupCreator(groupId) ||
                               getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid)) ||
                             (request.auth.uid == memberId && incoming().role == 'PARTICIPANT' &&
                              groupDocExists(groupId)) ||
                             isGroupCreator(groupId) ||
                             isGlobalAdmin()
                           )) ||
                           (request.auth == null &&
                            isGuestId(memberId) &&
                            incoming().role == 'PARTICIPANT' &&
                            incoming().tasksSignedUpCount == 0 &&
                            incoming().messagesSentCount == 0 &&
                            incoming().joinedAt == request.time &&
                            incoming().updatedAt == request.time &&
                            groupDocExists(groupId))
                         );
        allow update: if isValidId(memberId) &&
                         isValidMember(incoming()) &&
                         incoming().uid == existing().uid &&
                         incoming().joinedAt == existing().joinedAt && (
                           (isSignedIn() && (
                             // Action 1: Self profile/activity update (cannot change role)
                             (request.auth.uid == memberId &&
                              incoming().role == existing().role &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'tasksSignedUpCount', 'messagesSentCount', 'updatedAt'])) ||
                             // Action 2: Group Creator has full control over any non-creator member's role
                             ((isGroupCreator(groupId) || isGlobalAdmin()) &&
                              memberId != get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId &&
                              incoming().role in ['PARTICIPANT', 'ORGANIZER', 'ADMIN'] &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])) ||
                             // Action 3: Admin can promote non-admins, cannot demote existing ADMIN or touch CREATOR
                             (isGroupAdminOnly(groupId) &&
                              memberId != get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId &&
                              existing().role in ['PARTICIPANT', 'ORGANIZER'] &&
                              incoming().role in ['PARTICIPANT', 'ORGANIZER', 'ADMIN'] &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']))
                           )) ||
                           // Action 4: Code-joined guest self profile/activity update (cannot change role)
                           (request.auth == null &&
                            isGuestId(memberId) &&
                            existing().role in ['PARTICIPANT', 'ORGANIZER', 'ADMIN'] &&
                            incoming().role == existing().role &&
                            incoming().updatedAt == request.time &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'tasksSignedUpCount', 'messagesSentCount', 'updatedAt']))
                         );
        allow delete: if isValidId(memberId) && (
                         (isSignedIn() && (
                           (request.auth.uid == memberId && memberId != get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId) ||
                           ((isGroupCreator(groupId) || isGlobalAdmin()) && memberId != get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId) ||
                           (isGroupAdminOnly(groupId) &&
                            memberId != get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId &&
                            existing().role in ['PARTICIPANT', 'ORGANIZER'])
                         )) ||
                         (request.auth == null &&
                          isGuestId(memberId) &&
                          existing().role != 'CREATOR')
                       );
      }

      // Private PII subcollection: readable STRICTLY by Group Creator, Group Admins, Global Admins, or the signed-in owner
      match /memberContacts/{memberId} {
        allow get: if isSignedIn() && isValidId(memberId) &&
                      (request.auth.uid == memberId || isGroupAdminOrCreator(groupId) || isGlobalAdmin());
        allow list: if isSignedIn() && (isGroupAdminOrCreator(groupId) || isGlobalAdmin());
        allow create, update: if isValidId(memberId) &&
                                 isValidMemberContact(incoming()) &&
                                 incoming().uid == memberId &&
                                 incoming().updatedAt == request.time && (
                                   (isSignedIn() && (
                                     (request.auth.uid == memberId &&
                                      incoming().authMethod == 'GOOGLE' &&
                                      (isGroupMember(groupId) || isGroupCreator(groupId) || existsAfter(memberPath(groupId, memberId)))) ||
                                     isGroupAdminOrCreator(groupId) ||
                                     isGlobalAdmin()
                                   )) ||
                                   (request.auth == null &&
                                    isGuestId(memberId) &&
                                    incoming().authMethod == 'CODE_GUEST' &&
                                    (!('email' in incoming()) || incoming().email == null) &&
                                    (exists(memberPath(groupId, memberId)) || existsAfter(memberPath(groupId, memberId))))
                                 );
        allow delete: if isValidId(memberId) && (
                         (isSignedIn() && (request.auth.uid == memberId || isGroupAdminOrCreator(groupId) || isGlobalAdmin())) ||
                         (request.auth == null && isGuestId(memberId))
                       );
      }

      match /events/{eventId} {
        allow get, list: if isSignedIn()
                            ? (isGroupMember(groupId) || isGlobalAdmin())
                            : groupDocExists(groupId);
        allow create: if isSignedIn() && isValidId(eventId) &&
                         isValidEvent(incoming()) &&
                         incoming().createdBy == request.auth.uid &&
                         (isGroupOrganizerOrHigher(groupId) || isGlobalAdmin());
        allow update: if isSignedIn() && isValidId(eventId) &&
                         isValidEvent(incoming()) &&
                         incoming().createdBy == existing().createdBy &&
                         incoming().createdAt == existing().createdAt &&
                         (isGroupOrganizerOrHigher(groupId) || isGlobalAdmin()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'category', 'startEpochMs', 'endEpochMs', 'organizerName', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(eventId) &&
                         (isGroupAdminOrCreator(groupId) || existing().createdBy == request.auth.uid || isGlobalAdmin());

        match /tasks/{taskId} {
          allow get, list: if isSignedIn()
                              ? (isGroupMember(groupId) || isGlobalAdmin())
                              : groupDocExists(groupId);
          allow create: if isSignedIn() && isValidId(taskId) &&
                           isValidTask(incoming()) &&
                           incoming().eventId == eventId &&
                           incoming().createdBy == request.auth.uid &&
                           exists(/databases/$(database)/documents/groups/$(groupId)/events/$(eventId)) &&
                           (isGroupOrganizerOrHigher(groupId) || isGlobalAdmin());
          allow update: if isValidId(taskId) &&
                           isValidTask(incoming()) &&
                           incoming().eventId == existing().eventId &&
                           incoming().createdBy == existing().createdBy &&
                           incoming().createdAt == existing().createdAt && (
                             (isSignedIn() && (
                               // Action 1: Organizer / Admin / Creator full task edit
                               ((isGroupOrganizerOrHigher(groupId) || isGlobalAdmin()) &&
                                incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'deadlineEpochMs', 'capacity', 'assignedCount', 'assignedUids', 'assignedNames', 'status', 'chatChannelId', 'updatedAt'])) ||
                               // Action 2: Signed-in member claims a task slot
                               (isGroupMember(groupId) &&
                                existing().status != 'COMPLETED' &&
                                !(request.auth.uid in existing().assignedUids) &&
                                (request.auth.uid in incoming().assignedUids) &&
                                incoming().assignedUids.size() == existing().assignedUids.size() + 1 &&
                                incoming().assignedCount == existing().assignedCount + 1 &&
                                incoming().assignedCount <= existing().capacity &&
                                incoming().assignedNames.size() == existing().assignedNames.size() + 1 &&
                                incoming().status in ['OPEN', 'FILLED'] &&
                                incoming().diff(existing()).affectedKeys().hasOnly(['assignedUids', 'assignedNames', 'assignedCount', 'status', 'updatedAt'])) ||
                               // Action 3: Signed-in member leaves a task slot
                               (isGroupMember(groupId) &&
                                existing().status != 'COMPLETED' &&
                                (request.auth.uid in existing().assignedUids) &&
                                !(request.auth.uid in incoming().assignedUids) &&
                                incoming().assignedUids.size() == existing().assignedUids.size() - 1 &&
                                incoming().assignedCount == existing().assignedCount - 1 &&
                                incoming().assignedNames.size() == existing().assignedNames.size() - 1 &&
                                incoming().status == 'OPEN' &&
                                incoming().diff(existing()).affectedKeys().hasOnly(['assignedUids', 'assignedNames', 'assignedCount', 'status', 'updatedAt']))
                             )) ||
                             // Action 4: Code-joined guest member claims or leaves a task slot
                             (request.auth == null &&
                              existing().status != 'COMPLETED' &&
                              incoming().updatedAt == request.time &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['assignedUids', 'assignedNames', 'assignedCount', 'status', 'updatedAt']) && (
                                (incoming().assignedUids.size() == existing().assignedUids.size() + 1 &&
                                 incoming().assignedCount == existing().assignedCount + 1 &&
                                 incoming().assignedCount <= existing().capacity &&
                                 incoming().assignedNames.size() == existing().assignedNames.size() + 1 &&
                                 isGuestId(incoming().assignedUids[incoming().assignedUids.size() - 1]) &&
                                 exists(memberPath(groupId, incoming().assignedUids[incoming().assignedUids.size() - 1])) &&
                                 incoming().status in ['OPEN', 'FILLED']) ||
                                (incoming().assignedUids.size() == existing().assignedUids.size() - 1 &&
                                 incoming().assignedCount == existing().assignedCount - 1 &&
                                 incoming().assignedNames.size() == existing().assignedNames.size() - 1 &&
                                 incoming().status == 'OPEN')
                              ))
                           );
          allow delete: if isSignedIn() && isValidId(taskId) &&
                           (isGroupAdminOrCreator(groupId) || existing().createdBy == request.auth.uid || isGlobalAdmin());
        }
      }

      match /channels/{channelId} {
        allow get: if isValidId(channelId) && (
                      isSignedIn()
                        ? (isGlobalAdmin() || (isGroupMember(groupId) && canAccessChannel(groupId, existing().accessLevel)))
                        : (existing().accessLevel == 'ALL' && groupDocExists(groupId))
                    );
        allow list: if isSignedIn()
                       ? (isGlobalAdmin() || (isGroupMember(groupId) && canAccessChannel(groupId, resource.data.accessLevel)))
                       : (resource.data.accessLevel == 'ALL' && groupDocExists(groupId));
        allow create: if isSignedIn() && isValidId(channelId) &&
                         isValidChannel(incoming()) &&
                         incoming().createdBy == request.auth.uid &&
                         (isGlobalAdmin() ||
                          (isGroupOrganizerOrHigher(groupId) && canAccessChannel(groupId, incoming().accessLevel)) ||
                          isGroupCreatorAfter(groupId));
        allow update: if isValidId(channelId) &&
                         isValidChannel(incoming()) &&
                         incoming().createdBy == existing().createdBy &&
                         incoming().createdAt == existing().createdAt && (
                           (isSignedIn() && (
                             ((isGroupOrganizerOrHigher(groupId) || isGlobalAdmin()) &&
                              canAccessChannel(groupId, existing().accessLevel) &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'accessLevel', 'eventId', 'updatedAt'])) ||
                             (isGroupMember(groupId) &&
                              canAccessChannel(groupId, existing().accessLevel) &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'lastMessagePreview', 'lastMessageAt', 'updatedAt']))
                           )) ||
                           (request.auth == null &&
                            existing().accessLevel == 'ALL' &&
                            incoming().messageCount == existing().messageCount + 1 &&
                            incoming().updatedAt == request.time &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'lastMessagePreview', 'lastMessageAt', 'updatedAt']))
                         );
        allow delete: if isSignedIn() && isValidId(channelId) &&
                         (isGroupAdminOrCreator(groupId) || isGlobalAdmin());

        match /messages/{messageId} {
          allow get, list: if isSignedIn()
                              ? (isGlobalAdmin() || (isGroupMember(groupId) && canAccessChannelById(groupId, channelId)))
                              : isPublicGroupChannel(groupId, channelId);
          allow create: if isValidId(messageId) &&
                           isValidMessage(incoming()) &&
                           incoming().channelId == channelId && (
                             (isSignedIn() &&
                              incoming().senderId == request.auth.uid &&
                              (isGlobalAdmin() || (isGroupMember(groupId) && canAccessChannelById(groupId, channelId))) &&
                              (incoming().messageType == 'TEXT' || isGroupOrganizerOrHigher(groupId) || isGlobalAdmin())) ||
                             (request.auth == null &&
                              isGuestId(incoming().senderId) &&
                              exists(memberPath(groupId, incoming().senderId)) &&
                              isPublicGroupChannel(groupId, channelId) &&
                              incoming().senderRole in ['PARTICIPANT', 'ORGANIZER', 'ADMIN'] &&
                              incoming().messageType == 'TEXT' &&
                              incoming().createdAt == request.time)
                           );
          allow update: if isValidId(messageId) &&
                           isValidMessage(incoming()) &&
                           incoming().channelId == existing().channelId &&
                           incoming().senderId == existing().senderId &&
                           incoming().senderName == existing().senderName &&
                           incoming().senderRole == existing().senderRole &&
                           incoming().messageType == existing().messageType &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']) && (
                             (isSignedIn() &&
                              (isGlobalAdmin() || (isGroupMember(groupId) && canAccessChannelById(groupId, channelId))) &&
                              (existing().senderId == request.auth.uid || isGroupAdminOrCreator(groupId) || isGlobalAdmin())) ||
                             (request.auth == null &&
                              isGuestId(existing().senderId) &&
                              exists(memberPath(groupId, existing().senderId)) &&
                              isPublicGroupChannel(groupId, channelId) &&
                              incoming().updatedAt == request.time)
                           );
          allow delete: if isSignedIn() && isValidId(messageId) &&
                           (isGroupAdminOrCreator(groupId) || isGlobalAdmin());
        }
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(notificationId) && (
                      isSignedIn()
                        ? (isGlobalAdmin() ||
                           (isGroupMember(groupId) && (
                             canAccessNotification(groupId, existing().targetRole) ||
                             existing().senderId == request.auth.uid
                           )))
                        : (groupDocExists(groupId) && (
                            existing().targetRole in ['ALL', 'PARTICIPANT'] ||
                            isGuestId(existing().senderId)
                          ))
                   );
        allow list: if isSignedIn()
                       ? (isGlobalAdmin() ||
                          (isGroupMember(groupId) && (
                            canAccessNotification(groupId, resource.data.targetRole) ||
                            resource.data.senderId == request.auth.uid
                          )))
                       : (groupDocExists(groupId) && (
                           resource.data.targetRole in ['ALL', 'PARTICIPANT'] ||
                           isGuestId(resource.data.senderId)
                         ));
        allow create: if isValidId(notificationId) &&
                         isValidNotification(incoming()) && (
                           (isSignedIn() &&
                            incoming().senderId == request.auth.uid && (
                              (isGroupAdminOrCreator(groupId) || isGlobalAdmin()) ||
                              (incoming().notificationType in ['TASK_UPDATE', 'DEADLINE_REMINDER'] &&
                               isGroupOrganizerOrHigher(groupId) &&
                               (!('approvalStatus' in incoming()) || incoming().approvalStatus == 'APPROVED')) ||
                              (isGroupMember(groupId) &&
                               incoming().notificationType == 'ANNOUNCEMENT' &&
                               incoming().targetScope == 'ALL' &&
                               incoming().targetRole == 'ADMIN' &&
                               ('approvalStatus' in incoming()) &&
                               incoming().approvalStatus == 'PENDING')
                            )) ||
                           (request.auth == null &&
                            isGuestId(incoming().senderId) &&
                            exists(memberPath(groupId, incoming().senderId)) &&
                            incoming().notificationType == 'ANNOUNCEMENT' &&
                            incoming().targetScope == 'ALL' &&
                            incoming().targetRole == 'ADMIN' &&
                            ('approvalStatus' in incoming()) &&
                            incoming().approvalStatus == 'PENDING' &&
                            incoming().createdAt == request.time)
                         );
        allow update: if isSignedIn() && isValidId(notificationId) &&
                         isValidNotification(incoming()) &&
                         incoming().senderId == existing().senderId &&
                         incoming().senderName == existing().senderName &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'notificationType', 'targetScope', 'targetRole', 'targetChannelId', 'targetChannelName', 'targetEventId', 'scheduledForEpochMs', 'approvalStatus', 'updatedAt']) && (
                           (isGroupAdminOrCreator(groupId) || isGlobalAdmin()) ||
                           (existing().notificationType in ['TASK_UPDATE', 'DEADLINE_REMINDER'] &&
                            incoming().notificationType in ['TASK_UPDATE', 'DEADLINE_REMINDER'] &&
                            (!('approvalStatus' in incoming()) || incoming().approvalStatus == 'APPROVED') &&
                            isGroupOrganizerOrHigher(groupId)) ||
                           (isGroupMember(groupId) &&
                            existing().senderId == request.auth.uid &&
                            ('approvalStatus' in existing()) && existing().approvalStatus == 'PENDING' &&
                            ('approvalStatus' in incoming()) && incoming().approvalStatus == 'PENDING' &&
                            incoming().notificationType == 'ANNOUNCEMENT' &&
                            incoming().targetScope == 'ALL' &&
                            incoming().targetRole == 'ADMIN')
                         );
        allow delete: if isSignedIn() && isValidId(notificationId) &&
                         (isGroupAdminOrCreator(groupId) || isGlobalAdmin());
      }

      match /activityLogs/{logId} {
        allow get: if isSignedIn() && isValidId(logId) &&
                      (isGroupOrganizerOrHigher(groupId) || isGlobalAdmin());
        allow list: if isSignedIn() &&
                       (isGroupOrganizerOrHigher(groupId) || isGlobalAdmin());
        allow create: if isValidId(logId) &&
                         isValidActivityLog(incoming()) && (
                           (isSignedIn() &&
                            incoming().actorId == request.auth.uid &&
                            (isGroupMember(groupId) || isGlobalAdmin())) ||
                           (request.auth == null &&
                            isGuestId(incoming().actorId) &&
                            incoming().actorRole in ['PARTICIPANT', 'ORGANIZER', 'ADMIN'] &&
                            (exists(memberPath(groupId, incoming().actorId)) || existsAfter(memberPath(groupId, incoming().actorId))))
                         );
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(logId) &&
                         (isGroupAdminOrCreator(groupId) || isGlobalAdmin());
      }

      match /polls/{pollId} {
        allow get, list: if isSignedIn()
                            ? (isGroupMember(groupId) || isGroupCreator(groupId) || isGlobalAdmin())
                            : groupDocExists(groupId);
        allow create: if isSignedIn() && isValidId(pollId) &&
                         isValidPoll(incoming()) &&
                         incoming().createdBy == request.auth.uid &&
                         incoming().status == 'OPEN' &&
                         incoming().totalVotes == 0 &&
                         isValidZeroPollCounts(incoming().optionCounts) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time &&
                         (isGroupOrganizerOrHigher(groupId) || isGlobalAdmin());
        allow update: if isValidId(pollId) &&
                         isValidPoll(incoming()) &&
                         incoming().question == existing().question &&
                         ((!('description' in existing()) && !('description' in incoming())) ||
                          (('description' in existing()) && ('description' in incoming()) && incoming().description == existing().description)) &&
                         incoming().options == existing().options &&
                         incoming().createdBy == existing().createdBy &&
                         incoming().createdByName == existing().createdByName &&
                         incoming().createdByRole == existing().createdByRole &&
                         incoming().createdAt == existing().createdAt && (
                           // Action 1: Signed-in group member votes once atomically with ballot doc
                           (isSignedIn() &&
                            (isGroupMember(groupId) || isGroupCreator(groupId)) &&
                            existing().status == 'OPEN' &&
                            incoming().status == existing().status &&
                            incoming().totalVotes == existing().totalVotes + 1 &&
                            incoming().updatedAt == request.time &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['optionCounts', 'totalVotes', 'updatedAt']) &&
                            !exists(ballotPath(groupId, pollId, request.auth.uid)) &&
                            existsAfter(ballotPath(groupId, pollId, request.auth.uid)) &&
                            isValidOptionCountVote(
                              existing().optionCounts,
                              incoming().optionCounts,
                              getAfter(ballotPath(groupId, pollId, request.auth.uid)).data.optionIndex
                            )) ||
                           // Action 2: Code-joined guest member votes once
                           (request.auth == null &&
                            groupDocExists(groupId) &&
                            existing().status == 'OPEN' &&
                            incoming().status == existing().status &&
                            incoming().totalVotes == existing().totalVotes + 1 &&
                            incoming().optionCounts.size() == existing().optionCounts.size() &&
                            incoming().updatedAt == request.time &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['optionCounts', 'totalVotes', 'updatedAt'])) ||
                           // Action 3: Organizer, Admin, or Creator closes (or Creator/Admin reopens) poll
                           (isSignedIn() &&
                            (isGroupOrganizerOrHigher(groupId) || isGlobalAdmin()) &&
                            (existing().status == 'OPEN' || isGroupAdminOrCreator(groupId) || isGlobalAdmin()) &&
                            incoming().updatedAt == request.time &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                         );
        allow delete: if isSignedIn() && isValidId(pollId) &&
                         (isGroupAdminOrCreator(groupId) || existing().createdBy == request.auth.uid || isGlobalAdmin());

        // Strict Anonymity Guarantee:
        // Regular members and regular admins can only read their OWN ballot (if signed in) and CANNOT list ballots.
        // Only the Group Creator (ownerId) can list/read all ballots for Creator View.
        match /ballots/{userId} {
          allow get: if isSignedIn() && isValidId(pollId) && isValidId(userId) &&
                        (request.auth.uid == userId || isGroupCreator(groupId));
          allow list: if isSignedIn() && isGroupCreator(groupId);
          allow create: if isValidId(pollId) && isValidId(userId) &&
                           isValidPollBallot(incoming()) &&
                           incoming().userId == userId &&
                           incoming().createdAt == request.time &&
                           exists(pollPath(groupId, pollId)) &&
                           get(pollPath(groupId, pollId)).data.status == 'OPEN' &&
                           incoming().optionIndex < get(pollPath(groupId, pollId)).data.options.size() &&
                           !exists(ballotPath(groupId, pollId, userId)) &&
                           getAfter(pollPath(groupId, pollId)).data.totalVotes == get(pollPath(groupId, pollId)).data.totalVotes + 1 &&
                           getAfter(pollPath(groupId, pollId)).data.optionCounts[incoming().optionIndex] == get(pollPath(groupId, pollId)).data.optionCounts[incoming().optionIndex] + 1 &&
                           (
                             (isSignedIn() &&
                              request.auth.uid == userId &&
                              (isGroupMember(groupId) || isGroupCreator(groupId))) ||
                             (request.auth == null &&
                              isGuestId(userId) &&
                              exists(memberPath(groupId, userId)))
                           );
          allow update: if false;
          allow delete: if isSignedIn() && isValidId(pollId) && isValidId(userId) &&
                           (isGroupAdminOrCreator(groupId) ||
                            isGlobalAdmin() ||
                            (exists(pollPath(groupId, pollId)) && get(pollPath(groupId, pollId)).data.createdBy == request.auth.uid));
        }
      }
    }
  }
}
